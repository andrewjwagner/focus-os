# Optional allowlist. Leave empty so any email works in local mode.
# Set to your address if you want a single-user gate.
NEXT_PUBLIC_ALLOWED_EMAIL=

# Optional Firebase Auth + Firestore. Leave blank to use local IndexedDB.
# Create a Firebase web app, enable Google sign-in, then paste the config here.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional Capture -> Triage bot webhook (Grok Bot / Cursor automation).
# After a successful local IndexedDB save of an Idea, Todo, or Project, the
# Next.js route POST /api/capture/triage forwards this JSON payload:
#   { source, version, kind, id, body, domain, projectId, name?, createdAt, capturedAt }
# Leave both blank to keep Capture local-only. Missing URL or secret is a quiet skip.
# Auth header sent to the webhook:
#   Authorization: Bearer <TRIAGE_WEBHOOK_SECRET>
TRIAGE_WEBHOOK_URL=
TRIAGE_WEBHOOK_SECRET=

# Optional Team tab Granola sync. Server only: never prefix with NEXT_PUBLIC.
# Create a personal API key in Granola with the "Personal notes" scope.
# Configure people and their Granola folder names in the app (Team, Settings).
GRANOLA_API_KEY=

# Optional Team tab AI. Server only: never prefix with NEXT_PUBLIC.
# The first one set wins, in this order:
#   1. OLLAMA_MODEL: local Ollama (free, nothing leaves your machine), e.g. llama3.1:8b or qwen2.5:7b.
#      OLLAMA_BASE_URL defaults to http://localhost:11434.
#   2. XAI_API_KEY: xAI Grok (default model grok-4.7).
#   3. ANTHROPIC_API_KEY: Claude Sonnet.
#   4. OPENAI_API_KEY: GPT.
# TEAM_AI_MODEL overrides the default model for whichever provider is active.
# With none set, the Team tab uses built-in rules.
OLLAMA_MODEL=
OLLAMA_BASE_URL=
XAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
TEAM_AI_MODEL=
