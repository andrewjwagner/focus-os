# Andrew-only gate. Default is already this address if unset.
NEXT_PUBLIC_ALLOWED_EMAIL=andrew.wagner179@gmail.com

# Optional Firebase Auth + Firestore. Leave blank to use local IndexedDB dogfood.
# Create a Firebase web app, enable Google sign-in, then paste the config here.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional Capture -> Triage bot webhook (Grok Bot / Cursor automation).
# After a successful local IndexedDB save of an Idea, Todo, or Project, the
# Next.js route POST /api/capture/triage forwards this JSON payload:
#   { source, version, kind, id, body, domain, projectId, name?, createdAt, capturedAt }
# Leave both blank to keep Capture local-only. Missing URL or secret is a quiet skip.
# Auth header sent to the webhook (Grok Bot routines expect Bearer):
#   Authorization: Bearer <TRIAGE_WEBHOOK_SECRET>
TRIAGE_WEBHOOK_URL=
TRIAGE_WEBHOOK_SECRET=
